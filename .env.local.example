# Vite Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Stripe Publishable Key (get from https://dashboard.stripe.com/apikeys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Premium Price ID (create in Stripe Dashboard under Products)
VITE_STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id_here

# Backend API URL
VITE_API_URL=http://localhost:3001
