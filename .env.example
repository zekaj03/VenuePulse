# RevenueCat (required for native subscription purchase/restore)
VITE_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ENTITLEMENT_ID=premium

# Remote server-backed app state (web + native webview)
VITE_REMOTE_STATE_ENABLED=true
VITE_VENUE_ID=venuepulse-main

# Vercel server environment variables (set in Vercel project settings, not client-side)
# Provided by Vercel KV / Upstash integration
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxx
